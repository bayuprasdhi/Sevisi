    {
      "parameters": {
        "jsCode": "// Ambil teks dari input\nlet rawText = $input.first().json.ParsedResults[0].ParsedText|| \"\"; // ganti \"text\" sesuai nama field OCR kamu\n\n// Bersihkan karakter aneh\nrawText = rawText\n  .replace(/•/g, \"O\")\n  .replace(/ø/g, \"o\")\n  .replace(/\\s+/g, \" \")\n  .trim();\n\n// Bikin regex untuk ambil data\nconst data = {\n  kantor_cabang: (rawText.match(/Kantor Cabang\\s*:\\s*(.+?)\\s+\\d{1,2}'?\\d{4}/i) || [])[1] || null,\n  tanggal: (rawText.match(/: (\\d{1,2}'\\d{4})/) || [])[1] || null,\n  nomor_kwitansi: (rawText.match(/NOMOR\\s*:\\s*(\\d+)/i) || [])[1] || null,\n  nama_perusahaan: (rawText.match(/NOMOR\\s*:\\s*\\d+\\s+([A-Z ]+)/i) || [])[1] || null,\n  nilai_rupiah: (rawText.match(/Rp\\s*([\\d\\.\\,]+)/i) || [])[1] || null,\n  nilai_terbilang: (rawText.match(/Rp\\s*[\\d\\.\\,]+\\s+([A-Z ]+)/i) || [])[1] || null,\n  bank: (rawText.match(/BANK\\s+([A-Z ]+)/i) || [])[1] || null,\n};\n\nreturn [{ json: data }];\n"
      },
      "type": "n8n-nodes-base.code",
